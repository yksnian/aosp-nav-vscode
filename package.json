{
  "name": "aosp-nav",
  "displayName": "Android Source Navigation",
  "description": "go-to-definition and completion across all android java modules",
  "publisher": "yksnian",
  "version": "0.1.4",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/yksnian/aosp-nav-vscode" },
  "icon": "icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": ["onLanguage:java"],
  "extensionDependencies": ["redhat.java"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "aosp-nav.rescan", "title": "AOSP: Rescan Jars", "category": "AOSP" },
      { "command": "aosp-nav.diagnostics", "title": "AOSP: Show Diagnostics", "category": "AOSP" },
      { "command": "aosp-nav.fixEclipseBlockers", "title": "AOSP: Fix Eclipse Metadata Blockers", "category": "AOSP" },
      { "command": "aosp-nav.resetSettings", "title": "AOSP: Reset Plugin Settings", "category": "AOSP" }
    ],
    "configuration": {
      "title": "AOSP Dev",
      "properties": {
        "aosp-nav.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the plugin"
        },
        "aosp-nav.androidRoot": {
          "type": ["string", "null"],
          "default": null,
          "description": "Explicit AOSP root path. If null, auto-detected from the opened file path"
        },
        "aosp-nav.excludeJars": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Regex patterns matched against jar file name AND module name (appended to defaults)"
        },
        "aosp-nav.excludePaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Substring keywords matched against the full jar path (appended to defaults)"
        },
        "aosp-nav.excludeGlobs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Regex patterns matched against the path relative to .intermediates/ (appended to defaults). Anchor with ^ for top-level dirs, e.g. ^external/cronet/"
        },
        "aosp-nav.excludeMerge": {
          "type": "string",
          "enum": ["append", "replace"],
          "default": "append",
          "description": "append = user exclusion lists are added after defaults; replace = defaults discarded"
        },
        "aosp-nav.settingsScope": {
          "type": "string",
          "enum": ["global", "workspace"],
          "default": "workspace",
          "description": "Where java.project.referencedLibraries is written. workspace (default): .vscode/settings.json inside the repo, no impact on other Java projects; global: user settings, shared across windows but absolute jar paths pollute non-AOSP Java projects"
        },
        "aosp-nav.kotlin.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Kotlin support (experimental, P1)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js || vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
